# Cashir — copy to .env and fill in. NEVER commit .env.
# Maker wallet seed (64 hex). This wallet holds the XMR (side 1) or XNO (side 0) you make a market with.
XNOXMR_MAKER_SEED=

# Which side to make. 1 = you sell XMR for XNO (role B, default). 0 = you sell XNO for XMR (role A).
CASHIR_SIDE=1
# Offer size in XNO (must be >= the fee-driven minimum, ~25-31 XNO; `cashir quote` prints it).
CASHIR_SIZE_XNO=50
# Cron cadence for Hermes (2–5 minutes is right; offers have a 600 s TTL).
CASHIR_INTERVAL=3m
# Where Hermes delivers each cycle report / HANDOFF alert: local, telegram, discord, slack, signal, or platform:chat_id
CASHIR_DELIVER=local
# Consecutive failed cycles before Cashir withdraws and pauses itself (fail closed).
CASHIR_MAX_CONSECUTIVE_ERRORS=3
# Live mode. 0 = dry-run (nothing touches the ledger/relay). 1 = real offers.
# Offer-rate multiplier on the volatility-adaptive spread (0.75–3.0). 1 = normal;
# higher = more profit per fill, fewer fills. Set live from the dashboard slider.
CASHIR_SPREAD_MULT=1
CASHIR_LIVE=0

# Optional infra overrides (defaults are the public ones the skill ships with)
#XNOXMR_WORK_URL=https://www.nearinstant.xyz
#XNOXMR_NANO_NODES=https://rpc.nano-gpt.com,https://rainstorm.city/api,https://node.somenano.com/proxy
#XNOXMR_MONERO_NODES=https://xmr.hexide.com:443,https://node.sethforprivacy.com:443

# Autonomous settlement. Leave OFF. Unproven end-to-end; a human settles each HANDOFF from https://www.nearinstant.xyz
XNOXMR_AUTOSETTLE=0
